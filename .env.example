# Copy to .env to override defaults (see src/visarag/config.py). All optional.

# API bind address (the service has no auth; keep it on localhost or a private network)
# VISARAG_HOST=127.0.0.1
# VISARAG_PORT=8000

# Ollama server
# VISARAG_OLLAMA_URL=http://localhost:11434

# Generator (Ollama tag). qwen3.5:4b fits fully on an 8 GB GPU next to the reranker.
# VISARAG_GEN_MODEL=qwen3.5:4b
# VISARAG_NUM_CTX=6144

# Embedder: "st:<huggingface id>" runs in-process (default), "ollama:<tag>" goes through Ollama.
# Changing it needs a re-index: `make index`.
# VISARAG_EMBED_MODEL=st:BAAI/bge-m3
# VISARAG_QUERY_DEVICE=cpu
# VISARAG_INDEX_DEVICE=cuda

# Cross-encoder reranker (sentence-transformers)
# VISARAG_RERANKER=BAAI/bge-reranker-v2-m3
# VISARAG_RERANKER_DEVICE=cuda

# Retrieval
# VISARAG_CANDIDATES=30
# VISARAG_RERANK_TOP_N=30
# VISARAG_CONTEXT_K=6
# VISARAG_MIN_RERANK_SCORE=0.02
